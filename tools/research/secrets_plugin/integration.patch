+QByteArray Rnp::encryptPublic(const QByteArray &data,
+                              const QList<QPair<QString, QByteArray>> &recipients,
+                              bool armor, rnp_result_t *status)
+{
+    if (!status)
+        return QByteArray();
+    *status = RNP_ERROR_BAD_PARAMETERS;
+    if (recipients.isEmpty())
+        return QByteArray();
+    rnp_ffi_t raw = nullptr;
+    *status = rnp_ffi_create(&raw, RNP_KEYSTORE_GPG, RNP_KEYSTORE_GPG);
+    if (*status != RNP_SUCCESS)
+        return QByteArray();
+    FfiOwner context(raw, rnp_ffi_destroy);
+    for (const auto &recipient : recipients) {
+        if (recipient.first.isEmpty() || recipient.second.isEmpty()) {
+            *status = RNP_ERROR_BAD_PARAMETERS;
+            return QByteArray();
+        }
+        // Validate each payload independently: another payload must not satisfy
+        // its fingerprint. Loading both kinds detects secret packets instead of
+        // silently discarding them with a public-only import.
+        rnp_ffi_t checkRaw = nullptr;
+        *status = rnp_ffi_create(&checkRaw, RNP_KEYSTORE_GPG, RNP_KEYSTORE_GPG);
+        if (*status != RNP_SUCCESS)
+            return QByteArray();
+        FfiOwner check(checkRaw, rnp_ffi_destroy);
+        rnp_input_t inputRaw = nullptr;
+        *status = rnp_input_from_memory(&inputRaw,
+                    reinterpret_cast<const uint8_t *>(recipient.second.constData()),
+                    recipient.second.size(), false);
+        if (*status != RNP_SUCCESS)
+            return QByteArray();
+        InputOwner input(inputRaw, rnp_input_destroy);
+        *status = rnp_load_keys(checkRaw, RNP_KEYSTORE_GPG, inputRaw,
+                               RNP_LOAD_SAVE_PUBLIC_KEYS | RNP_LOAD_SAVE_SECRET_KEYS);
+        if (*status != RNP_SUCCESS)
+            return QByteArray();
+        size_t secrets = 0;
+        *status = rnp_get_secret_key_count(checkRaw, &secrets);
+        if (*status != RNP_SUCCESS || secrets) {
+            *status = RNP_ERROR_BAD_PARAMETERS;
+            return QByteArray();
+        }
+        const QByteArray fp = recipient.first.toUpper().toLatin1();
+        rnp_key_handle_t keyRaw = nullptr;
+        *status = rnp_locate_key(checkRaw, "fingerprint", fp.constData(), &keyRaw);
+        KeyOwner selected(keyRaw, rnp_key_handle_destroy);
+        if (*status != RNP_SUCCESS || !keyRaw) {
+            *status = RNP_ERROR_KEY_NOT_FOUND;
+            return QByteArray();
+        }
+        rnp_input_t aggregateRaw = nullptr;
+        *status = rnp_input_from_memory(&aggregateRaw,
+                    reinterpret_cast<const uint8_t *>(recipient.second.constData()),
+                    recipient.second.size(), false);
+        if (*status != RNP_SUCCESS)
+            return QByteArray();
+        InputOwner aggregate(aggregateRaw, rnp_input_destroy);
+        *status = rnp_load_keys(raw, RNP_KEYSTORE_GPG, aggregateRaw, RNP_LOAD_SAVE_PUBLIC_KEYS);
+        if (*status != RNP_SUCCESS)
+            return QByteArray();
+    }
+    rnp_input_t inputRaw = nullptr;
+    *status = rnp_input_from_memory(&inputRaw, reinterpret_cast<const uint8_t *>(data.constData()),
+                                    data.size(), false);
+    if (*status != RNP_SUCCESS)
+        return QByteArray();
+    InputOwner input(inputRaw, rnp_input_destroy);
+    rnp_output_t outputRaw = nullptr;
+    *status = rnp_output_to_memory(&outputRaw, 1024 * 1024 * 1024);
+    if (*status != RNP_SUCCESS)
+        return QByteArray();
+    OutputOwner output(outputRaw, rnp_output_destroy);
+    rnp_op_encrypt_t opRaw = nullptr;
+    *status = rnp_op_encrypt_create(&opRaw, raw, inputRaw, outputRaw);
+    if (*status != RNP_SUCCESS)
+        return QByteArray();
+    std::unique_ptr<rnp_op_encrypt_st, decltype(&rnp_op_encrypt_destroy)>
+        operation(opRaw, rnp_op_encrypt_destroy);
+    *status = rnp_op_encrypt_set_armor(opRaw, armor);
+    if (*status != RNP_SUCCESS)
+        return QByteArray();
+    for (const auto &recipient : recipients) {
+        const QByteArray fp = recipient.first.toUpper().toLatin1();
+        rnp_key_handle_t keyRaw = nullptr;
+        *status = rnp_locate_key(raw, "fingerprint", fp.constData(), &keyRaw);
+        KeyOwner key(keyRaw, rnp_key_handle_destroy);
+        if (*status != RNP_SUCCESS || !keyRaw) {
+            *status = RNP_ERROR_KEY_NOT_FOUND;
+            return QByteArray();
+        }
+        // Native selection supports cert/sign-only primaries with encryption
+        // subkeys; a primary's own encrypt flag is not a prerequisite.
+        *status = rnp_op_encrypt_add_recipient(opRaw, keyRaw);
+        if (*status != RNP_SUCCESS)
+            return QByteArray();
+    }
+    *status = rnp_op_encrypt_execute(opRaw);
+    if (*status != RNP_SUCCESS)
+        return QByteArray();
+    uint8_t *bytes = nullptr;
+    size_t length = 0;
+    *status = rnp_output_memory_get_buf(outputRaw, &bytes, &length, false);
+    return *status == RNP_SUCCESS
+        ? QByteArray(reinterpret_cast<const char *>(bytes), length) : QByteArray();
+}
