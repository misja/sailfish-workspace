+// Public export never includes secret packets. A primary needs its encryption
+// subkeys for ordinary OpenPGP recipient selection; an explicit subkey does not.
+QByteArray Rnp::publicKey(const Key &key, rnp_result_t *status) const
+{
+    if (!status)
+        return QByteArray();
+    *status = RNP_ERROR_BAD_PARAMETERS;
+    if (!m_ffi || key.m_ffi != m_ffi || !key.isValid())
+        return QByteArray();
+    bool primary = false;
+    *status = rnp_key_is_primary(key, &primary);
+    if (*status != RNP_SUCCESS)
+        return QByteArray();
+    rnp_output_t raw = nullptr;
+    *status = rnp_output_to_memory(&raw, 1024 * 1024 * 1024);
+    if (*status != RNP_SUCCESS)
+        return QByteArray();
+    OutputOwner output(raw, rnp_output_destroy);
+    *status = rnp_key_export(key, raw, RNP_KEY_EXPORT_PUBLIC
+                            | (primary ? RNP_KEY_EXPORT_SUBKEYS : 0));
+    if (*status != RNP_SUCCESS)
+        return QByteArray();
+    uint8_t *bytes = nullptr;
+    size_t length = 0;
+    *status = rnp_output_memory_get_buf(raw, &bytes, &length, false);
+    return *status == RNP_SUCCESS
+        ? QByteArray(reinterpret_cast<const char *>(bytes), length) : QByteArray();
+}
