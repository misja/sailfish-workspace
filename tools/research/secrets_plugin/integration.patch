+// QVariant containers received over D-Bus can remain QDBusArgument values.
+// Accept only the declared container signature and use Qt's native decoder.
+template<typename T>
+static bool decodeRecipientContainer(const QVariant &value, const char *signature, T *output)
+{
+    if (value.userType() == qMetaTypeId<T>()) {
+        *output = value.value<T>();
+        return true;
+    }
+    if (value.userType() != qMetaTypeId<QDBusArgument>())
+        return false;
+    const QDBusArgument argument = value.value<QDBusArgument>();
+    if (argument.currentSignature() != QLatin1String(signature))
+        return false;
+    *output = qdbus_cast<T>(argument);
+    return true;
+}
