+QByteArray Rnp::decrypt(const QByteArray &data, const Key &key,
+                       rnp_result_t *status, QList<Signature> *signers) const
+{
+    if (!status)
+        return QByteArray();
+    FfiOwner context(requestContext(key, status), rnp_ffi_destroy);
+    if (!context)
+        return QByteArray();
+    rnp_input_t inputRaw = nullptr;
+    *status = rnp_input_from_memory(&inputRaw, reinterpret_cast<const uint8_t *>(data.constData()), data.size(), false);
+    if (*status != RNP_SUCCESS)
+        return QByteArray();
+    InputOwner input(inputRaw, rnp_input_destroy);
+    QByteArray result;
+    rnp_output_t outputRaw = nullptr;
+    *status = rnp_output_to_callback(&outputRaw, appendPlaintext, nullptr, &result);
+    if (*status != RNP_SUCCESS)
+        return QByteArray();
+    OutputOwner output(outputRaw, rnp_output_destroy);
+    rnp_op_verify_t opRaw = nullptr;
+    *status = rnp_op_verify_create(&opRaw, context.get(), inputRaw, outputRaw);
+    if (*status != RNP_SUCCESS)
+        return QByteArray();
+    VerifyOwner operation(opRaw, rnp_op_verify_destroy);
+    *status = rnp_op_verify_execute(opRaw);
+    if (*status != RNP_SUCCESS)
+        return QByteArray();
+    rnp_recipient_handle_t usedRecipient = nullptr;
+    *status = rnp_op_verify_get_used_recipient(opRaw, &usedRecipient);
+    if (*status != RNP_SUCCESS || !usedRecipient) {
+        *status = RNP_ERROR_NO_SUITABLE_KEY;
+        return QByteArray();
+    }
+    if (signers) {
+        signers->clear();
+        size_t count = 0;
+        *status = rnp_op_verify_get_signature_count(opRaw, &count);
+        if (*status != RNP_SUCCESS)
+            return QByteArray();
+        for (size_t i = 0; i < count; ++i) {
+            rnp_op_verify_signature_t signature = nullptr;
+            *status = rnp_op_verify_get_signature_at(opRaw, i, &signature);
+            if (*status != RNP_SUCCESS)
+                return QByteArray();
+            signers->append(toSignature(context.get(), signature));
+        }
+    }
+    return result;
+}
+
+QByteArray Rnp::sign(const QByteArray &data, const Key &key, bool armor,
+                    rnp_result_t *status) const
+{
+    if (!status)
+        return QByteArray();
+    FfiOwner context(requestContext(key, status), rnp_ffi_destroy);
+    if (!context)
+        return QByteArray();
+    rnp_key_handle_t keyRaw = nullptr;
+    const QByteArray fingerprint = key.fingerprint().toLatin1();
+    *status = rnp_locate_key(context.get(), "fingerprint", fingerprint.constData(), &keyRaw);
+    KeyOwner selected(keyRaw, rnp_key_handle_destroy);
+    if (*status != RNP_SUCCESS || !keyRaw) {
+        *status = RNP_ERROR_KEY_NOT_FOUND;
+        return QByteArray();
+    }
+    rnp_input_t inputRaw = nullptr;
+    *status = rnp_input_from_memory(&inputRaw, reinterpret_cast<const uint8_t *>(data.constData()), data.size(), false);
+    if (*status != RNP_SUCCESS)
+        return QByteArray();
+    InputOwner input(inputRaw, rnp_input_destroy);
+    rnp_output_t outputRaw = nullptr;
+    *status = rnp_output_to_memory(&outputRaw, 1024 * 1024);
+    if (*status != RNP_SUCCESS)
+        return QByteArray();
+    OutputOwner output(outputRaw, rnp_output_destroy);
+    rnp_op_sign_t opRaw = nullptr;
+    *status = rnp_op_sign_detached_create(&opRaw, context.get(), inputRaw, outputRaw);
+    if (*status != RNP_SUCCESS)
+        return QByteArray();
+    SignOwner operation(opRaw, rnp_op_sign_destroy);
+    *status = rnp_op_sign_set_armor(opRaw, armor);
+    if (*status != RNP_SUCCESS)
+        return QByteArray();
+    *status = rnp_op_sign_add_signature(opRaw, keyRaw, nullptr);
+    if (*status != RNP_SUCCESS)
+        return QByteArray();
+    *status = rnp_op_sign_execute(opRaw);
+    if (*status != RNP_SUCCESS)
+        return QByteArray();
+    uint8_t *bytes = nullptr;
+    size_t length = 0;
+    *status = rnp_output_memory_get_buf(outputRaw, &bytes, &length, false);
+    return *status == RNP_SUCCESS ? QByteArray(reinterpret_cast<const char *>(bytes), length) : QByteArray();
+}
