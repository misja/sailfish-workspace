+namespace {
+bool appendPlaintext(void *context, const void *bytes, size_t length)
+{
+    auto *output = static_cast<QByteArray *>(context);
+    const size_t limit = 1024U * 1024U * 1024U;
+    const size_t current = static_cast<size_t>(output->size());
+    if (current > limit || length > limit - current || (length && !bytes))
+        return false;
+    if (length)
+        output->append(static_cast<const char *>(bytes), static_cast<int>(length));
+    return true;
+}
+
+using FfiOwner = std::unique_ptr<rnp_ffi_st, decltype(&rnp_ffi_destroy)>;
+using InputOwner = std::unique_ptr<rnp_input_st, decltype(&rnp_input_destroy)>;
+using OutputOwner = std::unique_ptr<rnp_output_st, decltype(&rnp_output_destroy)>;
+using KeyOwner = std::unique_ptr<rnp_key_handle_st, decltype(&rnp_key_handle_destroy)>;
+using VerifyOwner = std::unique_ptr<rnp_op_verify_st, decltype(&rnp_op_verify_destroy)>;
+using SignOwner = std::unique_ptr<rnp_op_sign_st, decltype(&rnp_op_sign_destroy)>;
+}
