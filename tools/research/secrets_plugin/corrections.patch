+// This private context contains exactly one selected secret key. Public primary
+// packets are retained for validation, without alternative secret siblings.
+rnp_ffi_t Rnp::requestContext(const Key &key, rnp_result_t *status) const
+{
+    *status = RNP_ERROR_BAD_PARAMETERS;
+    if (!m_ffi || key.m_ffi != m_ffi || !key.isValid() || !m_passwordProvider)
+        return nullptr;
+    rnp_ffi_t raw = nullptr;
+    *status = rnp_ffi_create(&raw, RNP_KEYSTORE_GPG, RNP_KEYSTORE_GPG);
+    if (*status != RNP_SUCCESS)
+        return nullptr;
+    FfiOwner context(raw, rnp_ffi_destroy);
+
+    rnp_output_t serialized = nullptr;
+    *status = rnp_output_to_memory(&serialized, 0);
+    if (*status != RNP_SUCCESS)
+        return nullptr;
+    const auto clearExport = [](rnp_output_st *output) {
+        uint8_t *bytes = nullptr;
+        size_t length = 0;
+        if (rnp_output_memory_get_buf(output, &bytes, &length, false) == RNP_SUCCESS && bytes)
+            rnp_buffer_clear(bytes, length);
+        rnp_output_destroy(output);
+    };
+    std::unique_ptr<rnp_output_st, decltype(clearExport)> exported(serialized, clearExport);
+    *status = rnp_key_export(key, serialized, RNP_KEY_EXPORT_SECRET);
+    if (*status != RNP_SUCCESS)
+        return nullptr;
+
+    uint8_t *bytes = nullptr;
+    size_t length = 0;
+    *status = rnp_output_memory_get_buf(serialized, &bytes, &length, false);
+    if (*status != RNP_SUCCESS)
+        return nullptr;
+    rnp_input_t inputRaw = nullptr;
+    *status = rnp_input_from_memory(&inputRaw, bytes, length, false);
+    if (*status != RNP_SUCCESS)
+        return nullptr;
+    InputOwner input(inputRaw, rnp_input_destroy);
+    *status = rnp_load_keys(raw, RNP_KEYSTORE_GPG, inputRaw,
+                           RNP_LOAD_SAVE_PUBLIC_KEYS | RNP_LOAD_SAVE_SECRET_KEYS);
+    if (*status != RNP_SUCCESS)
+        return nullptr;
+
+    bool primary = false;
+    *status = rnp_key_is_primary(key, &primary);
+    if (*status != RNP_SUCCESS)
+        return nullptr;
+    if (!primary) {
+        // Native subkey export includes its primary secret. Remove only that
+        // secret packet; retain primary public metadata and selected subkey.
+        rnp_key_handle_t primaryRaw = nullptr;
+        char *primaryFp = nullptr;
+        *status = rnp_key_get_fprint(key.m_primary, &primaryFp);
+        if (*status != RNP_SUCCESS || !primaryFp)
+            return nullptr;
+        const QByteArray fp(primaryFp);
+        rnp_buffer_destroy(primaryFp);
+        *status = rnp_locate_key(raw, "fingerprint", fp.constData(), &primaryRaw);
+        KeyOwner selectedPrimary(primaryRaw, rnp_key_handle_destroy);
+        if (*status != RNP_SUCCESS || !primaryRaw) {
+            *status = RNP_ERROR_KEY_NOT_FOUND;
+            return nullptr;
+        }
+        *status = rnp_key_remove(primaryRaw, RNP_KEY_REMOVE_SECRET);
+        if (*status != RNP_SUCCESS)
+            return nullptr;
+    }
+    size_t secretCount = 0;
+    *status = rnp_get_secret_key_count(raw, &secretCount);
+    if (*status != RNP_SUCCESS || secretCount != 1) {
+        *status = RNP_ERROR_BAD_PARAMETERS;
+        return nullptr;
+    }
+    const auto keyedPassword = [](rnp_ffi_t ffi, void *context, rnp_key_handle_t key,
+                                   const char *operation, char buffer[], size_t length) -> bool {
+        const auto *owner = static_cast<const Rnp *>(context);
+        // A stored-key request must never fall back to a symmetric password.
+        return key && owner->m_passwordProvider
+            && owner->m_passwordProvider(ffi, owner->m_passwordContext, key, operation, buffer, length);
+    };
+    *status = rnp_ffi_set_pass_provider(raw, keyedPassword, const_cast<Rnp *>(this));
+    if (*status != RNP_SUCCESS)
+        return nullptr;
+    return context.release();
+}
